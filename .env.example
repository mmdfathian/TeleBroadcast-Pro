# =================================================================
# TeleBroadcast-Pro - Environment Configuration Template
# =================================================================
# Instructions:
# 1. Copy this file and rename it to '.env'
# 2. Fill in your actual credentials below.
# 3. DO NOT share your '.env' file or commit it to GitHub.
# =================================================================

# --- Telegram API Credentials ---
# Get your API_ID and API_HASH from https://my.telegram.org/apps
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# --- Session Configuration ---
# The name for your Telethon session file (e.g., 'broadcast_account')
SESSION_NAME=tele_broadcast_pro

# --- Bot Settings (If applicable) ---
# Fill this only if you are using a Bot Token instead of a User Session
BOT_TOKEN=your_bot_token_here

# --- Logging & Debugging ---
# Options: INFO, DEBUG, WARNING, ERROR
LOG_LEVEL=INFO
